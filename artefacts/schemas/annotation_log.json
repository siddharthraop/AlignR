{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AlignR Annotation Log Entry",
  "description": "Schema for ART-001: one record per annotation event.",
  "type": "object",
  "required": [
    "annotator_id", "timestamp", "prompt_hash",
    "chosen_hash", "rejected_hash", "domain", "source"
  ],
  "properties": {
    "annotator_id":  { "type": "string" },
    "timestamp":     { "type": "string", "format": "date-time" },
    "prompt_hash":   { "type": "string", "minLength": 8 },
    "chosen_hash":   { "type": "string", "minLength": 8 },
    "rejected_hash": { "type": "string", "minLength": 8 },
    "rationale":     { "type": ["string", "null"] },
    "iaa_score":     { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 },
    "domain":        { "type": "string" },
    "n_annotators":  { "type": "integer", "minimum": 1 },
    "source":        { "type": "string" }
  }
}
